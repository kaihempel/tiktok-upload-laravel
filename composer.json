{
    "name": "kuweh/laravel-tiktok-upload",
    "description": "Upload videos and photo slideshows to the TikTok inbox via the Content Posting API (upload mode) from Laravel.",
    "keywords": [
        "laravel",
        "tiktok",
        "content-posting-api",
        "upload",
        "social-media"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "KaiHempel\\TikTokUpload\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaiHempel\\TikTokUpload\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "KaiHempel\\TikTokUpload\\TikTokUploadServiceProvider"
            ],
            "aliases": {
                "TikTok": "KaiHempel\\TikTokUpload\\Facades\\TikTok"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
